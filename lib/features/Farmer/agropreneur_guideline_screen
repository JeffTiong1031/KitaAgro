import 'package:flutter/material.dart';

class AgropreneurGuidelineScreen extends StatelessWidget {
  const AgropreneurGuidelineScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Become an Agropreneur')),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          const Text(
            'Step-by-Step Guide to Becoming a Malaysia Agropreneur',
            style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
          ),
          const SizedBox(height: 20),
          _buildStep(
            number: '1',
            title: 'Research & Planning',
            description:
                'Identify your agricultural focus, research market demand, and create a business plan.',
          ),
          _buildStep(
            number: '2',
            title: 'Obtain Necessary Licenses',
            description:
                'Register your business and obtain required permits from DOA (Department of Agriculture).',
          ),
          _buildStep(
            number: '3',
            title: 'Secure Land & Resources',
            description:
                'Acquire or lease agricultural land and gather necessary farming equipment.',
          ),
          _buildStep(
            number: '4',
            title: 'Undergo Training',
            description:
                'Attend agriculture training programs offered by government or private institutions.',
          ),
          _buildStep(
            number: '5',
            title: 'Start Small',
            description:
                'Begin with a small-scale operation to understand market dynamics and reduce risk.',
          ),
          _buildStep(
            number: '6',
            title: 'Apply for Subsidies',
            description:
                'Apply for Malaysian government agricultural subsidies and grants to support growth.',
          ),
          _buildStep(
            number: '7',
            title: 'Build Distribution Network',
            description:
                'Establish connections with wholesalers, retailers, and direct consumers.',
          ),
          _buildStep(
            number: '8',
            title: 'Scale Up Operations',
            description:
                'Expand your farm and diversify products based on market feedback and profitability.',
          ),
        ],
      ),
    );
  }

  Widget _buildStep({
    required String number,
    required String title,
    required String description,
  }) {
    return Card(
      margin: const EdgeInsets.only(bottom: 12),
      child: Padding(
        padding: const EdgeInsets.all(12),
        child: Row(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            CircleAvatar(
              backgroundColor: Colors.green,
              child: Text(
                number,
                style: const TextStyle(
                  color: Colors.white,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
            const SizedBox(width: 12),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    title,
                    style: const TextStyle(
                      fontWeight: FontWeight.bold,
                      fontSize: 16,
                    ),
                  ),
                  const SizedBox(height: 4),
                  Text(
                    description,
                    style: TextStyle(color: Colors.grey[600], fontSize: 14),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}
